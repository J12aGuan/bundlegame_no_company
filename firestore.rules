rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function hasOnly(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function participantRootWrite() {
      return hasOnly([
        'createdAt',
        'updatedAt',
        'researchStudy',
        'lastActivityAt'
      ]);
    }

    function participantSummaryWrite() {
      return hasOnly(['summaryByScenarioSetVersionId']);
    }

    function participantProgressWrite() {
      return hasOnly(['progressByScenarioSetVersionId']);
    }

    function participantActionWrite() {
      return hasOnly(['actionsByScenarioSetVersionId']);
    }

    function participantDetailedActionWrite() {
      return hasOnly(['detailedActionsByScenarioSetVersionId']);
    }

    function participantRoundActionWrite() {
      return hasOnly([
        'type',
        'scenarioSetVersionId',
        // dataset root name kept alongside the version id for data segregation.
        'scenario_set',
        'round_index',
        'scenario_id',
        'phase',
        // Paired pilot->35 calibration study: the cohort id and the part marker that links a
        // participant's two parts (pilot_unaided / enriched35_aided). Distinct from `phase` (the CHI
        // within-set block A/B). Without these on the allowlist the row is rejected by hasOnly.
        'study_id',
        'study_part',
        'classification',
        'study_protocol_id',
        'policy_arm',
        'policy_name',
        'policy_version',
        'dataset_snapshot_id',
        'legal_action_mask_version',
        'recommendation_source',
        'current_city',
        'final_location',
        'chosen_orders',
        'shown_recommendation_bundle_ids',
        'shown_ranked_bundles',
        'scenario_order_ids',
        'best_bundle_ids',
        'recommendation_quality',
        'success',
        'duration',
        'earnings',
        'reward',
        // optimality / regret summary emitted by normalizeRoundSummaryAction.
        'score_ratio_to_best',
        'percent_regret',
        'regret',
        'exact_optimal',
        'is_exact_optimal',
        'near_optimal',
        'is_near_optimal',
        'trust_rating',
        'usefulness_rating',
        'workload_rating',
        'liveSessionId',
        'decision_timestamp',
        'pre_state',
        'post_state',
        'state_snapshot',
        'outcome_snapshot',
        // CHI per-decision counterfactual feedback (the feedback actually shown + modeled score).
        // Without these the round-action write is rejected (hasOnly) and no decision log persists.
        'block',
        'block_kind',
        'test_set',
        'feedback_enabled',
        'violation_label',
        'best_improving_move',
        'feedback_text',
        'deployed_score',
        'score_ratio',
        'is_optimal',
        // Sign-survival gate decision (dynamic-protocol robustness layer). Without this key the
        // round-action write is rejected by hasOnly and the decision log silently fails to persist.
        'sign_survival_gate',
        'createdAt',
        'updatedAt'
      ]);
    }

    function liveParticipantWrite(participantId) {
      return request.resource.data.participantId == participantId
        && hasOnly([
          'participantId',
          'displayName',
          'earnings',
          'roundsCompleted',
          'optimalChoices',
          'totalGameTime',
          'completedGame',
          'status',
          'joinedAt',
          'lastActivityAt',
          'finalizedAt'
        ]);
    }

    function publicResultWrite(resultId) {
      return request.resource.data.userId is string
        && request.resource.data.resultAccessKey is string
        && resultId == (request.resource.data.userId + '__' + request.resource.data.resultAccessKey)
        && hasOnly([
          'userId',
          'scenarioSetVersionId',
          'scenarioSetName',
          'resultAccessKey',
          'earnings',
          'roundsCompleted',
          'optimalChoices',
          'totalGameTime',
          'completedGame',
          'updatedAt'
        ]);
    }

    function authTokenWrite() {
      return hasOnly(['userid', 'status'])
        && request.resource.data.userid is string
        && request.resource.data.status == 1;
    }

    // Public counter used by the participant entry flow. Public writes are limited
    // to creating the counter or incrementing count by exactly one.
    match /Global/totalusers {
      allow get: if true;
      allow list: if false;
      allow create: if hasOnly(['count']) && request.resource.data.count is int;
      allow update: if hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Participant token lookup is intentionally get-only for the browser login
    // flow. Listing and administrative changes require a Firebase admin claim.
    match /Auth/{docId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || authTokenWrite();
      allow update: if isAdmin() || (authTokenWrite() && resource.data.status == 1);
      allow delete: if isAdmin();
    }

    // Human-subject participant data is never listable/readable by the public.
    // The unauthenticated game can only append/update the narrow documents it
    // needs during play; full reads/exports require Firebase Auth with admin=true.
    match /Users/{userId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() || participantRootWrite();
      allow delete: if isAdmin();

      match /Actions/{actionId} {
        allow get, list: if isAdmin();
        allow create, update: if isAdmin() || participantRoundActionWrite();
        allow delete: if isAdmin();
      }

      match /Orders/{orderId} {
        allow get, list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /Summary/{summaryId} {
        allow get, list: if isAdmin();
        allow create, update: if isAdmin() || participantSummaryWrite();
        allow delete: if isAdmin();
      }

      match /Progress/{docId} {
        allow get, list: if isAdmin();
        allow create, update: if isAdmin() || participantProgressWrite();
        allow delete: if isAdmin();
      }

      match /ScenarioSet/{docId} {
        allow get, list: if isAdmin();
        allow create, update: if isAdmin() || participantProgressWrite();
        allow delete: if isAdmin();
      }

      match /Action/{docId} {
        allow get, list: if isAdmin();
        allow create, update: if isAdmin() || participantActionWrite();
        allow delete: if isAdmin();
      }

      match /DetailedAction/{docId} {
        allow get, list: if isAdmin();
        allow create, update: if isAdmin() || participantDetailedActionWrite();
        allow delete: if isAdmin();
      }
    }

    // Runtime configuration and scenario datasets must remain public so the
    // static game can load. Writes are admin-only.
    match /Configs/{configId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /MasterData/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Participants may discover the active classroom session and update only
    // their own leaderboard row shape. Session control and reads of participant
    // rows are admin-only.
    match /LiveSessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();

      match /participants/{participantId} {
        allow get, list: if isAdmin();
        allow create, update: if isAdmin() || liveParticipantWrite(participantId);
        allow delete: if isAdmin();
      }
    }

    // Minimal result summaries are public only by unguessable result-code doc ID.
    // Full participant records remain admin-only under /Users.
    match /PublicResults/{resultId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() || publicResultWrite(resultId);
      allow delete: if isAdmin();
    }

    // Research artifacts, models, survey responses, and sync logs are sensitive
    // study data. They are only available to Firebase users with admin=true.
    match /ResearchSnapshots/{snapshotId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /ResearchJobs/{jobId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /ResearchProtocols/{protocolId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /ResearchModels/{modelId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /QualtricsResponses/{responseId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /QualtricsSyncRuns/{runId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
	"name": "bundlegame-no-company",
	"version": "0.0.1",
	"private": true,
	"description": "BundleGame delivery bundling research app",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"verify": "npm run build && npm run test:js && npm run test:python",
		"test:js": "node --test --experimental-test-coverage tests/js/*.test.mjs && npm run test:scores && npm run test:protocol && npm run test:generator && npm run test:models",
		"test:scores": "node scripts/test-admin-scores.mjs",
		"test:protocol": "node scripts/test-research-protocol.mjs",
		"test:generator": "node scripts/test-scenario-generation.mjs",
		"test:models": "node scripts/test-model-registry.mjs",
		"test:python": "make test-python",
		"token": "node scripts/generate-auth-token.mjs",
		"qualtrics:sync": "node scripts/sync-qualtrics-responses.mjs",
		"scores:export": "node scripts/export-admin-scores.mjs",
		"firestore:connection:check": "node scripts/firestore-connection-check.mjs",
		"firestore:export:raw": "node scripts/export-firestore-research.mjs",
		"firestore:export:publication": "node scripts/export-firestore-publication-safe.mjs",
		"paper:artifacts": "node scripts/generate-paper-artifacts.mjs",
		"paper:figures-pdf": "node scripts/generate-paper-figures-pdf.mjs",
		"research:summary": "node scripts/research-data-summary.mjs",
		"research:worker": "node scripts/research-worker.mjs --once",
		"lint": "prettier --plugin-search-dir . --check .",
		"format": "prettier --plugin-search-dir . --write ."
	},
	"type": "module",
	"dependencies": {
		"@sveltejs/kit": "^2.49.0",
		"chart.js": "^4.5.1",
		"firebase": "^10.13.0",
		"firebase-admin": "^13.8.0",
		"svelte": "^5.28.2"
	},
	"engines": {
		"node": ">=18.x"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.5",
		"playwright-core": "^1.60.0",
		"vite": "^6.3.4"
	}
}

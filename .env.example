# ===========================================
# INTERNAL USE - Contact Nicholas for values
# ===========================================
# Copy this file to .env and fill in real values
# DO NOT commit .env to git (already in .gitignore)

# Firebase Configuration (Project: bundling-63c10)
# Get these from Nicholas or Firebase Console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-side Firebase Admin SDK access for local research exports.
# Preferred: leave GOOGLE_APPLICATION_CREDENTIALS blank and run:
#   gcloud auth application-default login
# Fallback: set GOOGLE_APPLICATION_CREDENTIALS to an absolute service-account
# JSON path. Never commit the service-account file.
FIREBASE_PROJECT_ID=bundling-63c10
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Emulator (dev-only, default OFF). Set to "true" to point the browser app
# (game + admin masterdata UI) at the LOCAL Firestore/Auth emulators instead of the
# bundling-63c10 project — the unblock for the pilot smoke-test (see docs/shared/EMULATOR_SMOKE.md).
# A normal build/deploy leaves this unset, so production is never affected.
VITE_USE_FIREBASE_EMULATOR=false
# Optional overrides (defaults shown) — match firebase.json emulators ports.
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
VITE_FIREBASE_EMULATOR_AUTH_PORT=9099

# MapTiler API Key
# Get from Nicholas or https://cloud.maptiler.com
VITE_MAPTILER_API_KEY=

# Admin / Downloader Access
# The downloader uses Firebase Auth in the browser. Do not add an admin password
# with a VITE_ prefix; sign in interactively with an account that has admin=true.
# Local server-side scripts use these private values to access admin-only
# Firestore collections when running outside the browser.
FIREBASE_ADMIN_EMAIL=
FIREBASE_ADMIN_PASSWORD=

# Optional salt for publication-safe pseudonymous participant IDs.
# Keep this private if you need pseudonyms to be stable across exports but hard
# to reverse from known class/user IDs.
PUBLICATION_PSEUDONYM_SALT=

# Qualtrics Response Sync (server/local scripts only)
# Never prefix these with VITE_ because that would expose secrets in browser builds.
QUALTRICS_API_TOKEN=
QUALTRICS_DATACENTER_ID=
QUALTRICS_SURVEY_ID=
